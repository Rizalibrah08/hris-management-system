# Database (XAMPP MySQL / Aiven MySQL / TiDB Cloud)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hris_db

# Database SSL (base64 CA certificate for Aiven/TiDB Cloud)
# Contoh: DB_SSL_CA=LS0tLS1CRUdJTi... (isi dari Aiven Console)
DB_SSL_CA=

# Security
JWT_SECRET=ganti-dengan-random-string-panjang
JWT_EXPIRY=1d

# Server
PORT=5000
NODE_ENV=development

# CORS (production)
# Contoh: CORS_ORIGIN=https://hris-web.vercel.app
CORS_ORIGIN=

# Cloudinary (untuk upload foto selfie & profile)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mobile (Expo public env)
EXPO_PUBLIC_API_URL=https://your-production-api.com
