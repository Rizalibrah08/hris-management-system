# =============================================================================
# HRIS Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your secure values
#   cp .env.example .env
#
# Generate strong secrets:
#   JWT_SECRET:  openssl rand -base64 48
#   DB_PASSWORD: openssl rand -base64 24
# =============================================================================

# --- Database ---
DB_PASSWORD=CHANGE_ME
DB_NAME=hris_db
DB_HOST=mysql
DB_PORT=3306
DB_USER=root

# --- Security ---
JWT_SECRET=CHANGE_ME
JWT_EXPIRY=1d

# --- Server ---
PORT=5000
NODE_ENV=production

# --- Optional: MySQL Resource Limits ---
# MYSQL_MEM_LIMIT=512m
# MYSQL_CPU_LIMIT=1.0
